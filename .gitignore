# Machine-specific symlink to the shared project data on CFS.
# The dataset root belongs in configs/config.yaml as paths.data.
/datasets

# Run outputs
/results/
/outputs/
/multirun/

# Environment
.venv/
__pycache__/
*.py[cod]

# Tooling caches
.pytest_cache/
.ruff_cache/
.hypothesis/

# LaTeX build artifacts inside run folders
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
site/

# Pages built by docs/gen_pages.py. `mkdocs build` keeps these in a temporary directory,
# but `mkdocs serve` materialises them into docs/ itself, so anyone who previews the site
# and then runs `git add -A` would commit build output -- including ~6 MB of figures that
# are already committed in their bundles. A stale copy here also shadows the freshly
# generated page, so the site would silently serve yesterday's content.
/docs/SUMMARY.md
/docs/catalogue.md
/docs/protocol.md
/docs/llms.txt
/docs/metrics/
/docs/degradations/
